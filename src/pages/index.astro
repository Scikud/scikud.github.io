---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostArticle from '../components/PostArticle.astro';

// The home page is the latest post. It canonicalises to that post's own URL so
// the two copies aren't treated as competing pages.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = posts[0];
---

<Base
  title={latest?.data.title}
  description={latest?.data.summary}
  canonical={latest && new URL(`/posts/${latest.id}/`, Astro.site)}
  currentId={latest?.id}
>
  {latest ? <PostArticle post={latest} /> : <p>No posts yet.</p>}
</Base>
